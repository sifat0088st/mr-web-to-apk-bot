PORT=8443
BUILD_SERVER_ID=ubuntu-builder-01
BUILD_SERVER_SECRET=replace-with-same-64-char-hex-secret-as-cloudflare
WORKER_PUBLIC_URL=https://mr-web-to-apk-bot.your-subdomain.workers.dev

TEMPLATE_DIR=/opt/mr-web-to-apk/android-webview-template
WORKSPACES_DIR=/var/lib/mr-web-to-apk/workspaces
DOCKER_IMAGE=mr-web-to-apk/android-builder:latest

APK_KEYSTORE_PATH=/etc/mr-web-to-apk/keys/platform-release.p12
APK_KEYSTORE_ALIAS=mrwebtoapk
APK_KEYSTORE_PASS=replace-with-strong-keystore-password
APK_KEY_PASS=replace-with-strong-key-password

MAX_CONCURRENT_BUILDS=2
DOCKER_CPUS=2
DOCKER_MEMORY=2g
