[Unit]
Description=MR WEB TO APK BOT - Isolated Android Build Agent
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=mrbuilder
Group=mrbuilder
WorkingDirectory=/opt/mr-web-to-apk/build-server
EnvironmentFile=/etc/mr-web-to-apk/builder.env
ExecStart=/usr/bin/node /opt/mr-web-to-apk/build-server/dist/server.js
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mr-web-to-apk/workspaces

[Install]
WantedBy=multi-user.target
